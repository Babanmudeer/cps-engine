# CPS Engine Environment

ENVIRONMENT=production

# Database
DB_NAME=cps_engine
DB_USER=cps_user
DB_PASSWORD=CHANGE_THIS_PASSWORD
DB_HOST=postgres
DB_PORT=5432

# Redis
REDIS_URL=redis://redis:6379
ENABLE_CACHE=true
CACHE_TTL=3600

# Gemini
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-1.5-pro
TEMPERATURE=0.3
MAX_TOKENS=2048

# Graph
GRAPH_NAME=hausahistory

# Security
SECRET_KEY=CHANGE_THIS_SECRET_KEY

# API Keys
API_KEY_DEV=CHANGE_THIS_DEV_KEY
API_KEY_PROD=CHANGE_THIS_PRO_KEY
API_KEY_ENTERPRISE=CHANGE_THIS_ENTERPRISE_KEY

# Rate Limiting
RATE_LIMIT_FREE_QUERIES=5
RATE_LIMIT_PRO_QUERIES=100
RATE_LIMIT_ENTERPRISE_QUERIES=500
RATE_LIMIT_WINDOW=60

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/cps_engine.log
JSON_LOGS=true

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Digital Mallam
ENABLE_MALLAM_PERSONA=true
MALLAM_GREETING=Sannu! Barka da zuwa!
MALLAM_PROVERBS=true
